<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		
		<PackageId>TubeSharp</PackageId>
		<Version>26.11.4.0-ea</Version>
		<Authors>Boba</Authors>
		<Description>A lightweight, strongly typed YouTube metadata client powered by the Innertube API.</Description>
		<PackageTags>youtube;innertube;metadata;search;nativeaot;dotnet</PackageTags>

		<PackageProjectUrl>https://github.com/boba1010/TubeSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/boba1010/TubeSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>Initial early-access release.</PackageReleaseNotes>
		<PackageIcon>icon.png</PackageIcon>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IsAotCompatible>true</IsAotCompatible>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="/" />
		<None Include="icon.png" Pack="true" PackagePath="/" />
	</ItemGroup>
</Project>